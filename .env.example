DATABASE_URL="file:./dev.db"
# ── Hosted database (required on Vercel) ──
# A deployment has no writable filesystem, so the SQLite file above cannot be
# used there. Set both of these to a Turso database and Prisma talks to it
# instead of the local file. DATABASE_URL must still be set (any value) because
# `prisma generate` reads it.
# TURSO_DATABASE_URL="libsql://your-db-your-org.turso.io"
# TURSO_AUTH_TOKEN=""
# 32-byte hex key (64 hex chars) for AES-256-GCM encryption of NWC URIs
ENCRYPTION_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# Optional pre-configured Mutinynet / Alby Hub Testnet NWC URI for 1-click Judge Demo Mode
DEMO_NWC_URI=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# How vendor Lightning Addresses are resolved:
#   unset  -> Alby's public LNURL proxy (default)
#   "false" -> resolve directly against the vendor's own domain (no third party)
#   a URL  -> route through your own LNURL proxy
# LNURL_PROXY_URL="false"
# Local mock wallet harness (`npm run e2e`) — never enable in production
# NWC_MOCK="1"
# MOCK_WALLET_URL="http://127.0.0.1:3101"
